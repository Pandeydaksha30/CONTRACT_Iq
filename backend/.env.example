# Copy to backend/.env and adjust. Every variable is prefixed CONTRACTIQ_.

# Browser origins allowed to call the API (comma-separated).
CONTRACTIQ_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Postgres + pgvector (infra/docker-compose.yml). Use 127.0.0.1, not localhost, on Windows.
CONTRACTIQ_DATABASE_URL=postgresql+psycopg://nyayasim:nyayasim_local_only@127.0.0.1:5432/nyayasim?connect_timeout=10

# Set to 1 to make database tests fail (not skip) when Postgres is down.
# CONTRACTIQ_REQUIRE_DB=1

# ── Accounts ──
# Address of the website (links in emails, Google redirect). Local dev: the Next.js dev server.
CONTRACTIQ_PUBLIC_URL=http://localhost:3100
# true only when served over HTTPS.
CONTRACTIQ_COOKIE_SECURE=false
# Optional "Continue with Google". Redirect URI to register: http://localhost:3100/api/v1/auth/google/callback
CONTRACTIQ_GOOGLE_CLIENT_ID=
CONTRACTIQ_GOOGLE_CLIENT_SECRET=
# Optional SMTP. Empty: emails are saved to data/outbox/ and their links printed in the API window.
CONTRACTIQ_SMTP_HOST=
CONTRACTIQ_SMTP_PORT=587
CONTRACTIQ_SMTP_USER=
CONTRACTIQ_SMTP_PASSWORD=
CONTRACTIQ_SMTP_FROM=ContractIQ <no-reply@localhost>

# ── Language model (Google Gemini) ──
# Key from https://aistudio.google.com. Kept on the server only; never commit backend/.env.
GEMINI_API_KEY=
CONTRACTIQ_GEMINI_MODEL=gemini-3.5-flash-lite
CONTRACTIQ_HEARING_MODEL=gemini-3.5-flash-lite
# Lets users mark their own case as a fictional demo (the only kind sent to the model).
CONTRACTIQ_ALLOW_DEMO_CASES=false
# Keep false until a zero-retention model is configured: real cases are never sent to the model.
CONTRACTIQ_PRIVATE_LLM_OK=false

# ── Search ──
# Local embedding model (fastembed). Changing it requires re-embedding all chunks.
CONTRACTIQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# If the model stays overloaded after this many retries, the call goes to the fallback model(s).
CONTRACTIQ_MODEL_RETRIES=2
CONTRACTIQ_FALLBACK_MODELS=gemini-3.6-flash

# ── Private demo mode (deployments only) ──
# One shared password in front of the whole site; the website needs the same value as SITE_PASSWORD.
# CONTRACTIQ_SITE_PASSWORD=
