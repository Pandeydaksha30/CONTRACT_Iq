# Settings for the all-in-one Docker stack (infra/docker-compose.prod.yml).
# Copy to infra/.env.prod (git-ignored) and fill in, or let infra/deploy.sh write it.
# Never commit the real file.

# Database password (a long random string).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# The address people open. With HTTPS (profile "https"): https://your-domain.
# Local test without Caddy: http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# true whenever PUBLIC_WEB_URL is https:// (cookies are then HTTPS-only, /docs is hidden).
COOKIE_SECURE=false

# Private demo mode: one shared password in front of the whole site (at least 10 characters).
# Leave empty for an open site.
SITE_PASSWORD=
# Lets users mark a case as a fictional demo, which unlocks the AI steps for that case.
# Only together with SITE_PASSWORD (a private evaluation site), never on an open public site.
ALLOW_DEMO_CASES=false

# AI model key (demo cases only). Optional.
GEMINI_API_KEY=
# Keep false: true would send real users' documents to a model that may retain data.
CONTRACTIQ_PRIVATE_LLM_OK=false

# "Continue with Google" (optional). Redirect URI: <PUBLIC_WEB_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing email (sign-up confirmation, password reset). Without it, confirm accounts with
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.prod exec api python -m scripts.admin_users verify EMAIL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ContractIQ <no-reply@example.com>

# Ports are bound to this machine only by default. WEB_BIND=0.0.0.0 only behind a firewall.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# HTTPS profile only: the domain pointing at this server.
DOMAIN=
