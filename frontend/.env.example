# Copy to frontend/.env.local (optional).
# Where the website forwards /api/* and fetches data while rendering pages (the FastAPI backend).
# The browser never calls the API directly: it uses /api on the website's own address.
API_URL=http://127.0.0.1:8000
# Private demo mode: the same value as the API's NYAYASIM_SITE_PASSWORD (server only; never
# NEXT_PUBLIC_). Leave unset for an open site.
# SITE_PASSWORD=
